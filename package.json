{
  "name": "musik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsx scripts/strip-dev-routes.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "verify": "pnpm test && pnpm check && pnpm typecheck && pnpm build",
    "spotify:auth": "tsx scripts/spotify-auth.ts",
    "import:spotify-export": "tsx scripts/import-spotify-export.ts",
    "sync:recently-played": "tsx scripts/sync-recently-played.ts",
    "enrich:metadata": "tsx scripts/enrich-metadata.ts",
    "enrich:backfill": "tsx scripts/enrich-backfill.ts",
    "external:status": "tsx scripts/external-metadata-status.ts",
    "explore:lastfm": "tsx scripts/explore-lastfm.ts",
    "import:lastfm-report": "tsx scripts/import-lastfm-report.ts",
    "invite": "tsx scripts/invite-user.ts",
    "db:size": "tsx scripts/db-size.ts"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.80",
    "@supabase/supabase-js": "^2.49.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.18.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.10",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
